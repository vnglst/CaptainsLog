      ],
      "status" : "corrected",
      "updated_at" : "2026-10-30T08:16:55Z",
      "words" : "Worf heeft gevraagd of we daarbij ook de afscherming van de sensoren controleren. Dat doen we, maar ik wil eerst met Geordi bespreken in welke volgorde. We kunnen niet alles tegelijk uitschakelen. Dan heeft de brug tijdelijk te weinig betrouwbare informatie"
    },
    "tng-nl01-D11" : {
      "accepted_take_id" : null,
      "audio_issue" : false,
      "context" : {
        "audio_sha256" : "aee104e58c261dc5bd91c6da002eac3ee0909b25b23c61de578e30eb72814cf9",
        "end_seconds" : 438,
        "reference_end_word" : 1081,
        "reference_sha256" : "b82391127acdbd43fbfdd34f35f1fcb952003b04fa59a07cebd124a39496bfc1",
        "reference_start_word" : 1026,
        "start_seconds" : 410
      },
      "notes" : "",
      "retakes" : [

      ],
      "status" : "corrected",
      "updated_at" : "2026-10-30T08:17:46Z",
      "words" : "Ik heb deze week ook een gesprek met commandant William Riker. Hij wil weten hoe het gaat met de nieuwe bemanningsleden tijdens de nachtdienst. Ik heb er twee ingewerkt. Ze kennen de procedures, maar aarzelen nog om iemand wakker te maken als een meting vreemd is. Dat herken ik van mijn eerste weken hier"
    },
